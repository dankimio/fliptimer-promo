---
import Layout from './Layout.astro';
import { app } from '../data/app.js';
const { frontmatter } = Astro.props;
---

<Layout title={`${frontmatter.title} — ${app.trackName}`}>
  <main id="main" class="mx-auto max-w-3xl px-6 pt-12 pb-20 sm:px-8 sm:pt-16 sm:pb-24">
    <article class="text-base leading-relaxed text-zinc-600 [&_h1]:mb-8 [&_h1]:text-4xl [&_h1]:font-semibold [&_h1]:tracking-tight [&_h1]:text-zinc-950 [&_h2]:mt-10 [&_h2]:mb-4 [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:tracking-tight [&_h2]:text-zinc-950 [&_p]:my-4">
      <slot />
    </article>
  </main>
</Layout>

---
import { Image } from 'astro:assets';
import screenshot from '../assets/screenshot.png';
import Layout from '../layouts/Layout.astro';
import { app } from '../data/app.js';

const features = [
  {
    title: 'Focus sessions',
    description: 'Work in intervals, with a break between sessions.',
    paths: ['M12 8v4l3 2', 'M9 2h6', 'M12 2v2', 'M19 5l-2 2'],
    circle: true,
  },
  {
    title: 'Start with a flip',
    description: 'Put your phone face down to start the timer. Keep it out of the way while you work.',
    paths: ['M8 3h8a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z', 'M11 17h2', 'M10 6h4'],
  },
  {
    title: 'Dark mode and custom timers',
    description: 'Choose a timer length and switch to dark mode.',
    paths: ['M20.9 13.2A9 9 0 0 1 10.8 3.1 9 9 0 1 0 20.9 13.2Z'],
  },
];
---

<Layout>
  <main id="main" class="mx-auto max-w-6xl px-6 sm:px-8">
    <section aria-labelledby="hero-title" class="grid items-center gap-12 pt-10 pb-16 sm:pt-12 sm:pb-20 lg:grid-cols-2 lg:gap-16 lg:pt-8">
      <div>
        <h1 id="hero-title" class="text-5xl font-semibold tracking-tight text-lavender sm:text-6xl">Flip Timer</h1>
        <p class="mt-6 max-w-md text-xl leading-relaxed text-zinc-700 sm:text-2xl">A focus timer you start by putting your phone down.</p>
        <p class="mt-4 max-w-md text-base leading-relaxed text-zinc-600">
          Place your phone face down to start a session. When the timer finishes, you’ll hear a chime. Take a break, then start again when you’re ready.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-5">
          <a href={app.trackViewUrl} target="_blank" rel="noopener noreferrer" aria-label="Download Flip Timer on the App Store" class="inline-flex rounded-xl transition-opacity hover:opacity-75">
            <img src="/appstore.png" width="180" height="60" alt="Download on the App Store" class="h-auto w-44" />
          </a>
          <p class="text-sm text-zinc-500">{app.formattedPrice} on the App Store</p>
        </div>
      </div>
      <figure class="flex min-w-0 justify-center">
        <div class="relative w-60 max-w-full rounded-[2.75rem] bg-zinc-950 p-1.5 shadow-lg ring-1 ring-zinc-400 sm:w-64 lg:w-72">
          <Image src={screenshot} alt="Flip Timer running a focus session with 24 minutes and 59 seconds remaining." widths={[480, 576, 768]} sizes="(min-width: 1024px) 276px, (min-width: 640px) 244px, 228px" loading="eager" fetchpriority="high" class="block h-auto w-full rounded-[2.375rem]" />
          <div aria-hidden="true" class="pointer-events-none absolute inset-0">
            <span class="absolute top-4 left-1/2 h-5 w-1/3 -translate-x-1/2 rounded-full bg-zinc-950"></span>
            <span class="absolute top-20 -left-0.5 h-4 w-0.5 rounded-l-sm bg-zinc-500"></span>
            <span class="absolute top-28 -left-0.5 h-8 w-0.5 rounded-l-sm bg-zinc-500"></span>
            <span class="absolute top-40 -left-0.5 h-8 w-0.5 rounded-l-sm bg-zinc-500"></span>
            <span class="absolute top-32 -right-0.5 h-12 w-0.5 rounded-r-sm bg-zinc-500"></span>
            <span class="absolute top-72 -right-0.5 h-6 w-0.5 rounded-r-sm bg-zinc-500"></span>
          </div>
        </div>
      </figure>
    </section>

    <section id="how-it-works" aria-labelledby="features-title" class="scroll-mt-8 border-t border-zinc-200 pt-10 pb-16 sm:pt-12 sm:pb-20">
      <h2 id="features-title" class="sr-only">Features</h2>
      <div class="grid gap-8 md:grid-cols-3 md:gap-10">
        {features.map((feature) => (
          <article>
            <span class="mb-5 flex size-11 items-center justify-center rounded-2xl bg-lavender-light text-lavender-dark">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="size-6" aria-hidden="true">
                {feature.circle && <circle cx="12" cy="13" r="9" />}
                {feature.paths.map((path) => <path d={path} />)}
              </svg>
            </span>
            <h3 class="text-lg leading-snug font-semibold text-zinc-900">{feature.title}</h3>
            <p class="mt-3 max-w-sm text-base leading-relaxed text-zinc-600">{feature.description}</p>
          </article>
        ))}
      </div>
    </section>
  </main>
</Layout>

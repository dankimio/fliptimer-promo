---
import { Image } from 'astro:assets';
import screenshot from '../assets/screenshot.png';
import Layout from '../layouts/Layout.astro';
import { app } from '../data/app.js';

const features = [
  {
    number: '01',
    title: 'Productivity Timer',
    description: 'Break up your work into intervals. Work on your tasks. Don’t forget to take breaks.',
    paths: ['M12 8v4l3 2', 'M9 2h6', 'M12 2v2', 'M19 5l-2 2'],
    circle: true,
  },
  {
    number: '02',
    title: 'Put Your Phone Away',
    description: 'Put your phone on the table, screen facing down. No distractions.',
    paths: ['M8 3h8a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z', 'M11 17h2', 'M10 6h4'],
  },
  {
    number: '03',
    title: 'Dark Mode, Customization and More',
    description: 'Custom timer length, dark mode and more to come. Stay tuned!',
    paths: ['M20.9 13.2A9 9 0 0 1 10.8 3.1 9 9 0 1 0 20.9 13.2Z'],
  },
];
---

<Layout>
  <main id="main" class="mx-auto max-w-6xl px-6 sm:px-8">
    <section aria-labelledby="hero-title" class="grid items-center gap-12 pt-10 pb-16 sm:pt-16 sm:pb-20 lg:grid-cols-2 lg:gap-16 lg:pt-12">
      <div>
        <p class="mb-6 text-xs font-semibold tracking-widest text-lavender-dark uppercase">{app.trackName}</p>
        <h1 id="hero-title" class="max-w-lg text-5xl leading-none font-semibold tracking-tighter sm:text-7xl">
          Phone down.<br /><span class="text-lavender">Focus on.</span>
        </h1>
        <p class="mt-8 max-w-md text-lg leading-relaxed text-zinc-600 sm:text-xl">Get through your tasks by putting your phone away.</p>
        <p class="mt-4 max-w-md text-base leading-relaxed text-zinc-600">
          To start the timer, put your device on the table, screen facing down. When the timer finishes, you will hear a chime. Enjoy your break and restart when you’re ready again!
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-5">
          <a href={app.trackViewUrl} target="_blank" rel="noopener noreferrer" aria-label="Download Flip Timer on the App Store" class="inline-flex rounded-xl transition-opacity hover:opacity-75">
            <img src="/appstore.png" width="180" height="60" alt="Download on the App Store" class="h-auto w-44" />
          </a>
          <p class="text-sm text-zinc-500">{app.formattedPrice} on the App Store</p>
        </div>
      </div>
      <figure class="flex min-w-0 flex-col items-center rounded-3xl bg-linear-to-br from-lavender-light via-white to-blue-100 px-6 pt-10 pb-6 sm:px-10 sm:pt-12 sm:pb-8">
        <div class="relative w-60 max-w-full rounded-[2.75rem] bg-zinc-950 p-2.5 shadow-2xl ring-1 ring-zinc-800 sm:w-64 lg:w-72">
          <Image src={screenshot} alt="Flip Timer running a focus session with 24 minutes and 59 seconds remaining." widths={[480, 576, 768]} sizes="(min-width: 1024px) 268px, (min-width: 640px) 236px, 220px" loading="eager" fetchpriority="high" class="block h-auto w-full rounded-[2.125rem]" />
          <div aria-hidden="true" class="absolute top-2 left-1/2 h-6 w-2/5 -translate-x-1/2 rounded-b-2xl bg-zinc-950"></div>
        </div>
        <figcaption class="mt-6 text-center text-xs font-medium tracking-wide text-zinc-600">A little less screen. A little more focus.</figcaption>
      </figure>
    </section>

    <section id="how-it-works" aria-labelledby="features-title" class="scroll-mt-8 border-t border-zinc-200 pt-12 pb-16 sm:pt-16 sm:pb-20">
      <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
        <h2 id="features-title" class="text-3xl font-semibold tracking-tight sm:text-4xl">A simpler way to focus.</h2>
        <p class="text-sm text-zinc-500">Flip. Focus. Take a break.</p>
      </div>
      <div class="grid gap-8 md:grid-cols-3 md:gap-10">
        {features.map((feature) => (
          <article>
            <div class="mb-5 flex items-center justify-between">
              <span class="flex size-11 items-center justify-center rounded-2xl bg-lavender-light text-lavender-dark">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="size-6" aria-hidden="true">
                  {feature.circle && <circle cx="12" cy="13" r="9" />}
                  {feature.paths.map((path) => <path d={path} />)}
                </svg>
              </span>
              <span class="font-mono text-xs text-zinc-400" aria-hidden="true">{feature.number}</span>
            </div>
            <h3 class="max-w-xs text-xl leading-snug font-semibold tracking-tight">{feature.title}</h3>
            <p class="mt-3 max-w-sm text-base leading-relaxed text-zinc-600">{feature.description}</p>
          </article>
        ))}
      </div>
    </section>
  </main>
</Layout>
